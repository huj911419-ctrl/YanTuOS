# 复制为 .env 后按需修改。scripts/start.sh 自动读取；shell 已设置的值优先。
# .env 已被 Git 忽略；真实密钥只留在本机，建议 chmod 600 .env。
YANTU_HOST=127.0.0.1
YANTU_PORT=8000
YANTU_DATABASE_PATH=data/yantu.sqlite3
YANTU_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
YANTU_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
YANTU_ACCESS_TOKEN=
# 默认没有配置模型；以下地址和模型留空时，可在页面保存非敏感配置。
# 如果使用页面配置，不要在 .env 中取消注释空的 URL/MODEL（环境变量优先）。
YANTU_AI_API_KEY=
# YANTU_AI_BASE_URL=https://your-compatible-provider.example/v1
# YANTU_AI_MODEL=your-model-id
# 局域网使用：填写明确的私有 IP，设置令牌、HTTPS 和对应允许的主机/来源。
# YANTU_TLS_CERT=/absolute/path/to/server.crt
# YANTU_TLS_KEY=/absolute/path/to/server.key
# YANTU_TLS_CA=/absolute/path/to/ca.crt
# 运行与日志目录默认 .runtime；无需修改系统服务。
# YANTU_RUNTIME_DIR=/absolute/path/to/runtime
